meta {
  name: Create Sandbox
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/sandboxes
  body: json
  auth: none
}

body:json {
  {
    "id": "{{sandboxId}}",
    "image": "alpine:latest"
  }
}

script:pre-request {
  const { v4: uuidv4 } = require('uuid');
  
  bru.setCollectionVar('sandboxId', uuidv4())
}
